<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="sat-c1-u06-recollection-sortitout" title="Sort It Out: Recollection" adaptive="true" time-dependent="false">

  <qti-response-declaration identifier="RESPONSE" cardinality="multiple" base-type="directedPair">
    <qti-correct-response>
      <qti-value>forgetfulness ANT</qti-value>
      <qti-value>memory SYN</qti-value>
      <qti-value>oblivion ANT</qti-value>
      <qti-value>reminiscence SYN</qti-value>
      <qti-value>remembrance SYN</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier"/>
  <qti-outcome-declaration identifier="INTERACTION_VISIBILITY" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>show_interaction</qti-value></qti-default-value>
  </qti-outcome-declaration>

  <qti-item-body>
    <qti-feedback-block identifier="show_interaction" outcome-identifier="INTERACTION_VISIBILITY" show-hide="show" class="qti-margin-0">
      <qti-content-body>
        <qti-match-interaction response-identifier="RESPONSE" shuffle="true" max-associations="5">
          <qti-prompt>Sort each word by its relationship to <strong>recollection</strong>.</qti-prompt>
          <qti-simple-match-set>
            <qti-simple-associable-choice identifier="forgetfulness" match-max="1">forgetfulness</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="memory" match-max="1">memory</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="oblivion" match-max="1">oblivion</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="reminiscence" match-max="1">reminiscence</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="remembrance" match-max="1">remembrance</qti-simple-associable-choice>
          </qti-simple-match-set>
          <qti-simple-match-set>
            <qti-simple-associable-choice identifier="SYN" match-max="5" fixed="true">Synonym</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="ANT" match-max="5" fixed="true">Antonym</qti-simple-associable-choice>
          </qti-simple-match-set>
        </qti-match-interaction>
      </qti-content-body>
    </qti-feedback-block>

    <qti-feedback-block identifier="correct" outcome-identifier="FEEDBACK" show-hide="show">
      <qti-content-body><p>All correct. Memory, reminiscence and remembrance sit on the same side as recollection; forgetfulness and oblivion are its opposites.</p></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="incorrect" outcome-identifier="FEEDBACK" show-hide="show">
      <qti-content-body><p>Not quite - try again. Ask of each word: does it point the same way as recollection, or the opposite way?</p></qti-content-body>
    </qti-feedback-block>
  </qti-item-body>

  <qti-response-processing>
    <qti-response-condition>
      <qti-response-if>
        <qti-match><qti-variable identifier="RESPONSE"/><qti-correct identifier="RESPONSE"/></qti-match>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">completed</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">correct</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
      <qti-response-else>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">0</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">incomplete</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">incorrect</qti-base-value></qti-set-outcome-value>
      </qti-response-else>
    </qti-response-condition>
  </qti-response-processing>
</qti-assessment-item>
