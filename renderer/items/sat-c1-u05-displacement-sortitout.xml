<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="sat-c1-u05-displacement-sortitout" title="Sort It Out: Displacement" adaptive="true" time-dependent="false">

  <qti-response-declaration identifier="RESPONSE" cardinality="multiple" base-type="directedPair">
    <qti-correct-response>
      <qti-value>uprooting SYN</qti-value>
      <qti-value>dislocation SYN</qti-value>
      <qti-value>homecoming ANT</qti-value>
      <qti-value>anchoring ANT</qti-value>
      <qti-value>expulsion SYN</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier"/>
  <qti-outcome-declaration identifier="INTERACTION_VISIBILITY" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>show_interaction</qti-value></qti-default-value>
  </qti-outcome-declaration>

  <qti-item-body>
    <qti-feedback-block identifier="show_interaction" outcome-identifier="INTERACTION_VISIBILITY" show-hide="show" class="qti-margin-0">
      <qti-content-body>
        <qti-match-interaction response-identifier="RESPONSE" shuffle="true" max-associations="5">
          <qti-prompt>Sort each word by its relationship to <strong>displacement</strong>.</qti-prompt>
          <qti-simple-match-set>
            <qti-simple-associable-choice identifier="uprooting" match-max="1">uprooting</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="dislocation" match-max="1">dislocation</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="homecoming" match-max="1">homecoming</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="anchoring" match-max="1">anchoring</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="expulsion" match-max="1">expulsion</qti-simple-associable-choice>
          </qti-simple-match-set>
          <qti-simple-match-set>
            <qti-simple-associable-choice identifier="SYN" match-max="5" fixed="true">Synonym</qti-simple-associable-choice>
            <qti-simple-associable-choice identifier="ANT" match-max="5" fixed="true">Antonym</qti-simple-associable-choice>
          </qti-simple-match-set>
        </qti-match-interaction>
      </qti-content-body>
    </qti-feedback-block>

    <qti-feedback-block identifier="correct" outcome-identifier="FEEDBACK" show-hide="show">
      <qti-content-body><p>All correct. Uprooting, dislocation and expulsion sit on the same side as displacement; homecoming and anchoring are its opposites.</p></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="incorrect" outcome-identifier="FEEDBACK" show-hide="show">
      <qti-content-body><p>Not quite - try again. Ask of each word: does it point the same way as displacement, or the opposite way?</p></qti-content-body>
    </qti-feedback-block>
  </qti-item-body>

  <qti-response-processing>
    <qti-response-condition>
      <qti-response-if>
        <qti-match><qti-variable identifier="RESPONSE"/><qti-correct identifier="RESPONSE"/></qti-match>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">completed</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">correct</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
      <qti-response-else>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">0</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">incomplete</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">incorrect</qti-base-value></qti-set-outcome-value>
      </qti-response-else>
    </qti-response-condition>
  </qti-response-processing>
</qti-assessment-item>
