  <qti-item-body>
    <qti-feedback-block identifier="show_interaction" outcome-identifier="INTERACTION_VISIBILITY" show-hide="show" class="qti-margin-0">
      <qti-content-body>
        <p>In which of these sentences is procure used correctly?</p>
    <qti-choice-interaction response-identifier="RESPONSE" shuffle="true" max-choices="1">
      <qti-simple-choice identifier="A">For the transplant wing, the hospital procured a scanner that only two factories in the world build.</qti-simple-choice>
