  </qti-response-declaration>
  <qti-response-declaration identifier="R3" cardinality="single" base-type="identifier">
    <qti-correct-response><qti-value>D</qti-value></qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="STAGE" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>q1</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="C_TEACH" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>on</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="C_KEEP" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>on</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="C_Q1" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>on</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FB1" cardinality="single" base-type="identifier"/>
  <qti-outcome-declaration identifier="C_Q2" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>off</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FB2" cardinality="single" base-type="identifier"/>
  <qti-outcome-declaration identifier="C_Q3" cardinality="single" base-type="identifier">
