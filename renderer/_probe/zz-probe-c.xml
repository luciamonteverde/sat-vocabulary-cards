<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="zz-probe-c" title="Probe C: staged block then unblock, one item" adaptive="true" time-dependent="false">
  <qti-response-declaration identifier="ACK" cardinality="single" base-type="identifier">
    <qti-correct-response><qti-value>GO</qti-value></qti-correct-response>
  </qti-response-declaration>
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response><qti-value>B</qti-value></qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value><qti-value>0</qti-value></qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="FEEDBACK" cardinality="single" base-type="identifier"/>
  <qti-outcome-declaration identifier="STAGE" cardinality="single" base-type="identifier">
    <qti-default-value><qti-value>study</qti-value></qti-default-value>
  </qti-outcome-declaration>

  <qti-item-body>
    <qti-feedback-block identifier="study" outcome-identifier="STAGE" show-hide="show">
      <qti-content-body><p><strong>TEACHING CONTENT</strong> &#8212; Archaic means belonging to an earlier period of time and no longer in current use.</p><p><em>STAGE 1 of 3 &#8212; study this, then press Continue/Submit below. Expected: this block disappears and a question replaces it.</em></p><qti-choice-interaction response-identifier="ACK" shuffle="false" max-choices="1"><qti-prompt>I have studied the definition above.</qti-prompt><qti-simple-choice identifier="GO">Continue &#8212; hide it and test me</qti-simple-choice></qti-choice-interaction></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="quiz" outcome-identifier="STAGE" show-hide="show">
      <qti-content-body><p><em>STAGE 2 of 3 &#8212; the definition should NOT be visible anywhere on screen now. Answer from memory.</em></p><qti-choice-interaction response-identifier="RESPONSE" shuffle="false" max-choices="1"><qti-prompt>Probe C &#8212; choose B.</qti-prompt><qti-simple-choice identifier="A">A (wrong on purpose)</qti-simple-choice><qti-simple-choice identifier="B">B (correct)</qti-simple-choice></qti-choice-interaction></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="done" outcome-identifier="STAGE" show-hide="show">
      <qti-content-body><p><strong>PROBE C &#8212; STAGE 3 of 3:</strong> if you saw the definition, then a question with the definition gone, and now see it again below, the FULL block/unblock cycle WORKS in a single item.</p><p><strong>TEACHING CONTENT</strong> &#8212; Archaic means belonging to an earlier period of time and no longer in current use.</p></qti-content-body>
    </qti-feedback-block>
    <qti-feedback-block identifier="incorrect" outcome-identifier="FEEDBACK" show-hide="show">
      <qti-content-body><p>Choose B to finish the probe.</p></qti-content-body>
    </qti-feedback-block>
  </qti-item-body>

  <qti-response-processing>
    <qti-response-condition>
      <qti-response-if>
        <qti-match><qti-variable identifier="STAGE"/><qti-base-value base-type="identifier">study</qti-base-value></qti-match>
        <qti-set-outcome-value identifier="STAGE"><qti-base-value base-type="identifier">quiz</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">incomplete</qti-base-value></qti-set-outcome-value>
      </qti-response-if>
      <qti-response-else-if>
        <qti-match><qti-variable identifier="RESPONSE"/><qti-correct identifier="RESPONSE"/></qti-match>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">1</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="STAGE"><qti-base-value base-type="identifier">done</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">completed</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">correct</qti-base-value></qti-set-outcome-value>
      </qti-response-else-if>
      <qti-response-else>
        <qti-set-outcome-value identifier="SCORE"><qti-base-value base-type="float">0</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="completionStatus"><qti-base-value base-type="identifier">incomplete</qti-base-value></qti-set-outcome-value>
        <qti-set-outcome-value identifier="FEEDBACK"><qti-base-value base-type="identifier">incorrect</qti-base-value></qti-set-outcome-value>
      </qti-response-else>
    </qti-response-condition>
  </qti-response-processing>
</qti-assessment-item>
